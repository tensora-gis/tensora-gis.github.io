# Identity of the Google OAuth Web client (Google Cloud Console).
# Build-time injected by Vite; in CI this comes from the repo secrets of the
# same name. See docs/AUTH_SETUP.md
VITE_GOOGLE_CLIENT_ID=

# "Web app / Deploy" URL of the Apps Script that records sign-ups to the
# Google Sheet (ends in /exec).
VITE_SIGNUP_ENDPOINT=
